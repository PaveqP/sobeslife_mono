EXPO_PUBLIC_API_URL=https://dev.sobeslife.ru

# OAuth: для Expo Go используется exp://… из makeRedirectUri (см. консоль после expo start).
# Для dev build — sobeslife://auth/google и sobeslife://auth/github.
# Зарегистрируйте фактический redirect URI в Google Cloud Console и GitHub OAuth App.
# Бэкенд также принимает exp://* автоматически; web URI — через OAUTH_GOOGLE_REDIRECT_URI на сервере.

# Опционально (если не используете makeRedirectUri):
# EXPO_PUBLIC_OAUTH_GOOGLE_REDIRECT_URI=
# EXPO_PUBLIC_OAUTH_GITHUB_REDIRECT_URI=
