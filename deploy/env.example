# Copy to project root on the server as `.env` (never commit real secrets).
# Used by: docker compose -f docker-compose.deploy.yml --env-file .env

DB_PASSWORD=change-me-strong-password
CONFIG_PATH=config/docker-config.yaml

# Миграции БД при старте API (golang-migrate). В Docker: MIGRATIONS_PATH=/app/migrations задаётся в compose.
# Экстренно отключить: SKIP_DB_MIGRATIONS=true
# Не дублируйте полную схему в postgres-init и в migrations — будет ошибка и dirty. Схема только в server/migrations.
# Если в schema_migrations зависло dirty после сбоя: один раз MIGRATE_CLEAR_DIRTY=true (как migrate force), затем убрать из .env. В проде не включать.
POLZA_AI_API_KEY=my-key

# JWT signing (required for auth; use long random strings in production)
ACCESS_SIGNING_KEY=change-me-access-key-min-32-chars
REFRESH_SIGNING_KEY=change-me-refresh-key-min-32-chars

OAUTH_GOOGLE_CLIENT_SECRET=change-me-google-client-secret
OAUTH_GOOGLE_CLIENT_ID=change-me-google-client-id
OAUTH_GOOGLE_REDIRECT_URI=https://dev.sobeslife.ru/auth/google
OAUTH_GITHUB_REDIRECT_URI=https://dev.sobeslife.ru/auth/github
OAUTH_MOBILE_GOOGLE_REDIRECT_URI=sobeslife://auth/google
OAUTH_MOBILE_GITHUB_REDIRECT_URI=sobeslife://auth/github

# Optional: host port for nginx (default 80). Use 8080 if something else uses 80.
# HTTP_PORT=80

# Admin: тот же домен, что и сайт — https://<host>/admin/ (хостовый nginx → ADMIN_HTTP_PORT).
# Порт 8081 — вход контейнера admin на хосте; снаружи обычно не открывают, только 80/443.
# ADMIN_HTTP_PORT=8081

# Frontend: leave empty for same-origin API through nginx (recommended).
# VITE_API_URL=

# Admin panel frontend: leave empty for same-origin proxying through admin nginx (recommended).
# VITE_ADMIN_API_URL=
